# ==============================================================================
# BACKEND (Python/Flask) + scripts de inicialização
# Copie este arquivo para ".env" e ajuste os valores:  cp .env.example .env
# Formato compatível com bash (sem espaços ao redor do "="; use aspas se houver espaços).
# Variáveis já definidas no ambiente do sistema têm prioridade sobre este arquivo.
# ==============================================================================

# --- Servidor Flask ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Origens autorizadas a acessar a API (CORS), separadas por vírgula.
# Em deploy, coloque o endereço público do painel. "*" libera qualquer origem.
CORS_ORIGINS=http://localhost:3000

# --- Câmera ---
# Endereço do ESP32-CAM. Se preenchido, o backend conecta ao stream ao iniciar.
# Deixe vazio para conectar depois, pelo painel (aba "Ao vivo").
ESP32_URL=
CAMERA_ID="CAM-01 · Portaria"

# --- Reconhecimento ---
# Distância LBPH máxima para autorizar (quanto menor, mais rígido). Faixa típica: 55 a 70.
LBPH_CONFIDENCE_THRESHOLD=65.0
# Tempo mínimo (segundos) entre dois registros da mesma pessoa no stream.
DEBOUNCE_SECONDS=4.0

# --- Orquestração (usado só por iniciar_sistema.sh) ---
# Porta do painel Next.js. Se mudar, atualize CORS_ORIGINS e NEXT_PUBLIC_API_URL.
FRONTEND_PORT=3000

# --- Segurança ---
# Tamanho máximo (MB) de imagens aceitas em POST /reconhecer. Acima disso: HTTP 413.
MAX_UPLOAD_MB=5
