# ==============================================================================
# .gitignore - Sistema de Reconhecimento Facial / TCC
# ==============================================================================

resumo.md

# --- Ambientes Virtuais Python ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Cache e Arquivos Compilados do Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Banco de Dados e Auditoria (Dados sensíveis / locais) ---
acessos.db
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Modelos Treinados e Classificadores (Gerados localmente) ---
modelo_lbph.yml
labels.json
*.h5
*.pkl
*.joblib
*.onnx
*.pt

# --- Biometria, Fotos e Rostos (Privacidade & LGPD) ---
# Mantém apenas o marcador .gitkeep para preservar as pastas no Git
dataset/*
!dataset/.gitkeep
static/acessos/*
!static/acessos/.gitkeep
static/desconhecidos/*
!static/desconhecidos/.gitkeep

# --- Frontend (Next.js / Node) ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Segredos, Variáveis de Ambiente e Credenciais ---
.env
.env*.local
*.env
secrets.h
credentials.h
wifi_credentials.h
*.pem
*.key
*.crt

# --- Arduino / ESP32 / C++ ---
.clangd
**/.clangd
.pio/
*.hex
*.bin
*.elf
*.o
*.a
*.d

# --- IDEs e Editores de Código ---
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user

# --- Arquivos do Sistema Operacional ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Logs e Arquivos Temporários ---
*.log
logs/
temp/
tmp/
