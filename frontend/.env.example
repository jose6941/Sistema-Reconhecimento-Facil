# ==============================================================================
# FRONTEND (Next.js)
# Copie este arquivo para ".env":  cp .env.example .env
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas no código durante o build.
# Se alterar o valor, reinicie o "npm run dev" ou refaça o "npm run build".
# ==============================================================================

# URL pública do backend Flask. Em deploy, use o endereço acessível pelo
# NAVEGADOR do usuário (não um endereço interno da rede do servidor).
NEXT_PUBLIC_API_URL=http://localhost:5000
