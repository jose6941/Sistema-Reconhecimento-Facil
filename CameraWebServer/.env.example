# ==============================================================================
# FIRMWARE (ESP32-CAM)
# A Arduino IDE não lê arquivos .env. Por isso, após editar este arquivo, rode:
#     python3 gerar_secrets.py
# Isso gera o "secrets.h" (ignorado pelo Git), incluído pelo CameraWebServer.ino.
# Copie este arquivo para ".env":  cp .env.example .env
# ==============================================================================

# Rede Wi-Fi 2,4 GHz à qual o ESP32-CAM vai se conectar.
WIFI_SSID=NOME_DA_SUA_REDE
WIFI_PASSWORD=SENHA_DA_SUA_REDE
